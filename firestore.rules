rules_version = '2';

// Live chat security model (spec §9).
//
// The customer widget runs in a hostile browser: every check the UI makes is
// advisory. THIS FILE is the only thing that actually stops a crafted request,
// so it is written deny-by-default and each allow is justified.
//
// Two principals:
//   agent    — request.auth.token.agent == true (set by scripts/set-agent-claim.mjs)
//   customer — an anonymous uid that owns exactly one conversation + one visitor doc
service cloud.firestore {
  match /databases/{database}/documents {

    function isAgent() {
      // Guarded with `'agent' in token` because a customer's auth token has no
      // `agent` claim at all — some rules-engine paths (ternary conditions in
      // particular) treat an undefined map key as a hard error rather than a
      // falsy value, which would wrongly deny a legitimate customer request.
      return request.auth != null
        && ('agent' in request.auth.token)
        && request.auth.token.agent == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Public presence (spec §5). Read-only to the world so the widget can show
    // "team is away" BEFORE the visitor signs in. It leaks no uids — one field.
    match /status/team {
      allow read: if true;
      allow write: if isAgent();
    }

    // A visitor may touch only their OWN doc, keyed by their anonymous uid.
    // (Phase 3 adds journey/geo here; the server writes geo via the Admin SDK,
    // which bypasses rules, so no client-write allowance is needed for it.)
    match /visitors/{visitorId} {
      allow read:          if isAgent() || (isSignedIn() && request.auth.uid == visitorId);
      allow create, update: if isAgent() || (isSignedIn() && request.auth.uid == visitorId);
      allow delete:        if isAgent();
    }

    match /conversations/{conversationId} {
      function owned() {
        return isSignedIn()
          && resource != null
          && resource.data != null
          && resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isAgent() || owned();

      // A customer may open a conversation only in their own name. Forging
      // ownerUid would otherwise let them read a thread they do not own.
      allow create: if isAgent() || (
        isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
      );

      // A customer may update their own conversation, but may NOT reassign it,
      // clear the follow-up flag, or change the status. status is pinned to its
      // existing value so a visitor cannot close their own thread (which would
      // drop it from the agent inbox that filters status == 'open') — spec §9.
      // needsFollowUp is the safety-net flag — only /api/chat/escalate (Admin SDK)
      // or an agent may set it.
      function getExisting(field, fallback) {
        return resource != null && resource.data != null && field in resource.data
          ? resource.data[field]
          : fallback;
      }

      allow update: if isAgent() || (
        owned()
        && request.resource.data.ownerUid == getExisting('ownerUid', '')
        && request.resource.data.visitorId == getExisting('visitorId', '')
        && request.resource.data.needsFollowUp == getExisting('needsFollowUp', false)
        && request.resource.data.status == getExisting('status', 'open')
      );

      allow delete: if isAgent();

      match /messages/{messageId} {
        function conv() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function ownsThread() {
          return isSignedIn() && conv().ownerUid == request.auth.uid;
        }

        allow read: if isAgent() || ownsThread();

        // The load-bearing rule. A customer may write only as themselves (or as
        // the system, for the §6.1 timeout notice), is length-capped, and may
        // NOT carry an attachment — customer upload is deliberately not a thing
        // in Phase 1 (spec §14), so the field is refused outright.
        //
        // `link` is refused for the same reason, and one sharper one: quick-send
        // links are an agent-only console feature (§4.1 A), and the thread is
        // rendered in the CONSOLE, where the reader holds an `agent: true` token
        // and can see every conversation. A visitor writing to their own thread
        // with the SDK could otherwise plant a `javascript:` URI in a link card
        // and aim it at the salesperson. The renderer refuses the scheme too
        // (lib/chat/safeUrl.ts); this is the layer that stops it being stored.
        //
        // #6 security: the 'system' sender is the §6.1 timeout notice only.
        // Pinning the text to the known constant prevents a visitor using the SDK
        // from planting attacker-authored text that renders in the agent console
        // as an official amber "platform statement" notice box.
        //
        // #7 security: `emailedAt` is stamped only by the reply-email server
        // route. A customer writing a future emailedAt would cause the route's
        // orderBy("emailedAt","desc").limit(1) to return that forged time as
        // lastEmailedAt and permanently suppress future agent reply-emails.
        allow create: if isAgent()
          ? request.resource.data.sender in ['agent', 'system']
          : (
              ownsThread()
              && request.resource.data.sender in ['customer', 'system']
              && request.resource.data.text is string
              && request.resource.data.text.size() <= 2000
              && !('attachment' in request.resource.data)
              && !('link' in request.resource.data)
              && !('emailedAt' in request.resource.data)
              && (
                   request.resource.data.sender != 'system'
                   || request.resource.data.text == 'Sorry — our team is tied up. We have your details and will reply on WhatsApp/email shortly.'
                 )
            );

        // Messages are an append-only log. Only an agent may amend one (the
        // reply-email route stamps emailedAt via the Admin SDK anyway).
        allow update, delete: if isAgent();
      }
    }

    // Push targets (Phase 2). A customer must never enumerate them.
    match /agentDevices/{token} {
      allow read, write: if isAgent();
    }
  }
}
