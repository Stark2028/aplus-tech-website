# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
build.log

# firebase emulator artifacts (written by `npm run test:rules`)
firestore-debug.log
firebase-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / AI workspace
/.claude/
/.cursor/
/.vscode/
/.superpowers/

# Local-only backups of large media (kept outside git for size)
/public/videos/*-original.*

# Local-only analysis artifacts (not part of the website)
/Website_Comparison_Report.*
/gen_comparison.py
/parse_lh.py
/diagnose_lcp.py
/diagnose2.py
/lh-*.json
/lh-*.html
/lighthouse-*.json
/build-out.txt
# Office temp/lock files
~$*
